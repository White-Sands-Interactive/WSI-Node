{
  "name": "wsi-framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @whitesands/agent-player && npm run build -w @wsi/agent-platform && npm run build -w @wsi/forest-example && npm run build -w @wsi/courier-example",
    "docs": "npm run docs -w @whitesands/agent-player",
    "version-packages": "changeset version",
    "release": "npm run build -w @whitesands/agent-player && npm publish -w @whitesands/agent-player --access public --provenance",
    "test": "vitest run",
    "test:watch": "vitest",
    "forest": "npm run start -w @wsi/forest-example",
    "platform": "npm run start -w @wsi/agent-platform",
    "platform:create-key": "npm run create-key -w @wsi/agent-platform --",
    "platform:list-keys": "node packages/agent-platform/dist/cli.js list-keys"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@changesets/cli": "^2.29.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
